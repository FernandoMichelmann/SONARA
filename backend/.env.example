# Copy this file to .env and replace every secret before use.
APP_ENV=development
APP_NAME=SONARA API
API_V1_PREFIX=/api/v1
# SQLite is the default for local development. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://sonara:CHANGE_ME@localhost:5432/sonara
DATABASE_URL=sqlite:///./sonara.db
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# The developer account is created/updated at API startup when both values exist.
# Never commit your real .env file or share these credentials.
DEVELOPER_EMAIL=owner@example.com
DEVELOPER_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD
DEVELOPER_NAME=SONARA Owner

# Gmail SMTP - password must be a Google App Password (16 characters), NOT your Gmail login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sonaramultitracks@gmail.com
SMTP_PASSWORD=CHANGE_THIS_TO_YOUR_GMAIL_APP_PASSWORD
SMTP_FROM_EMAIL=sonaramultitracks@gmail.com
SMTP_FROM_NAME=SONARA
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Local Live Server URL. In production, replace with the public SONARA website URL.
FRONTEND_BASE_URL=http://127.0.0.1:5500

# InfinitePay Checkout Integrado - keep the API Key only in backend/.env.
INFINITEPAY_API_KEY=inchk_REPLACE_WITH_YOUR_SECRET_KEY
INFINITEPAY_HANDLE=SONARASTUDIOMULTITRACK
# Public HTTPS backend endpoint in production. Leave empty for local redirect-only testing.
INFINITEPAY_WEBHOOK_URL=

# Google Drive OAuth (Google Cloud Console)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/developer/drive/callback
