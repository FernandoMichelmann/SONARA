# Copy this file to .env and replace every secret before use.
APP_ENV=development
APP_NAME=SONARA API
API_V1_PREFIX=/api/v1
# SQLite is the default for local development. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://sonara:CHANGE_ME@localhost:5432/sonara
DATABASE_URL=sqlite:///./sonara.db
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000

# The developer account is created/updated at API startup when both values exist.
# Never commit your real .env file or share these credentials.
DEVELOPER_EMAIL=owner@example.com
DEVELOPER_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD
DEVELOPER_NAME=SONARA Owner
